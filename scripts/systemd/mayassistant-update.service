[Unit]
Description=Update Mayassistant app and worker from GitHub main
Wants=network-online.target
After=network-online.target docker.service
Requires=docker.service

[Service]
Type=oneshot
ExecStart=/usr/bin/bash /usr/local/lib/mayassistant-update/update-vps.sh
TimeoutStartSec=infinity
TimeoutStopSec=infinity
UMask=0077
CPUWeight=20
Nice=10
