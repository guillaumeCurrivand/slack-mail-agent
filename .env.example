# Internal app port. Docker Compose pins this to 3000 and publishes host port 3001.
PORT=3000
PUBLIC_URL=https://your-agent.example.com
DATABASE_URL=postgresql://agent:change-me@localhost:5432/agent
# Comma-separated built-in module IDs. Empty runs shared help/budget only.
ENABLED_MODULES=mail
# Used by compose.yaml; use a URL-safe random value.
POSTGRES_PASSWORD=
# Required when mail is enabled: exactly 32 random bytes, encoded as base64.
ENCRYPTION_KEY=
SLACK_TEAM_ID=
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
# Optional Slack user ID to receive operational budget alerts privately.
SLACK_ADMIN_USER_ID=
# Mail module credentials; not required when mail is disabled.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Comma-separated verified Google Workspace hosted domains; required for mail.
GOOGLE_WORKSPACE_DOMAINS=example.com
# Required for Mail Sorter; Slack Unanswered uses it for contextual matching and keeps direct matching available without it.
OPENAI_API_KEY=
# With an API key, the model must have a verified price card in src/core/budget.ts.
OPENAI_MODEL=gpt-4.1-mini-2025-04-14
AI_MONTHLY_LIMIT_USD=10
AI_ALERT_USD=8
# Optional per-user monthly ceiling, within the shared team limit.
AI_USER_MONTHLY_LIMIT_USD=10
WORKER_CONCURRENCY=2
