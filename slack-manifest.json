{
  "display_information": {
    "name": "Mayassistant",
    "description": "L'assistant AI de Maya !",
    "background_color": "#253649"
  },
  "features": {
    "bot_user": { "display_name": "Mayassistant", "always_online": false },
    "app_home": { "home_tab_enabled": false, "messages_tab_enabled": true, "messages_tab_read_only_enabled": false }
  },
  "oauth_config": { "scopes": { "bot": ["chat:write", "im:history", "channels:read", "groups:read", "channels:history", "groups:history", "users:read"] } },
  "settings": {
    "event_subscriptions": {
      "request_url": "https://mail.tyrstats.com/slack/events",
      "bot_events": ["message.im"]
    },
    "interactivity": { "is_enabled": true, "request_url": "https://mail.tyrstats.com/slack/actions" },
    "org_deploy_enabled": false,
    "socket_mode_enabled": false,
    "token_rotation_enabled": false
  }
}
